# Application Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Database
DATABASE_URL=sqlite:///./jobs.db

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# OCR Configuration (Options: tesseract, mock)
OCR_ENGINE=tesseract
TESSERACT_CMD=

# Google Docs Integration (Service Account or OAuth2)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
